{
  "name": "Student Profiles (C++ / Crow)",
  "image": "mcr.microsoft.com/devcontainers/cpp:ubuntu-24.04",

  // Kept from failing the whole creation: a container that comes up with
  // an unfinished build can still be worked in, while a failure here
  // would replace it with the bare recovery image.
  "onCreateCommand": "bash .devcontainer/setup.sh || echo 'SETUP FAILED - read the errors above, then run ./.devcontainer/setup.sh by hand'",

  "forwardPorts": [8090],
  "portsAttributes": {
    "8090": {
      "label": "Student Profiles",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
