{
  "name": "Student Profiles (C++ / Crow)",
  "image": "mcr.microsoft.com/devcontainers/cpp:ubuntu-24.04",

  "onCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [8090],
  "portsAttributes": {
    "8090": {
      "label": "Student Profiles",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
