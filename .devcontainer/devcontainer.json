{
  "name": "Student Profiles (C++ / Crow)",
  "image": "mcr.microsoft.com/devcontainers/cpp:ubuntu-24.04",

  // The C++ image has no SSH server, and without one the codespace
  // cannot be reached from the gh command line, only from the browser.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },

  // Kept from failing the whole creation: a container that comes up with
  // an unfinished build can still be worked in, while a failure here
  // would replace it with the bare recovery image.
  "onCreateCommand": "bash .devcontainer/setup.sh || echo 'SETUP FAILED - read the errors above, then run ./.devcontainer/setup.sh by hand'",

  // Brings the server back up on its own whenever the codespace is started or
  // resumed, so a stop does not leave the site dead until someone SSHes in.
  "postStartCommand": "bash .devcontainer/start-server.sh",

  "forwardPorts": [8090],
  "portsAttributes": {
    "8090": {
      "label": "Student Profiles",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ]
    }
  }
}
